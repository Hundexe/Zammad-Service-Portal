# Service-Portal – Konfiguration
#
# Das ist die EINE Konfigurationsdatei auf dem Server. Kopieren nach deploy/.env und anpassen:
#   cp .env.example .env
# Änderungen werden mit einem Neustart wirksam:
#   docker compose --env-file .env up -d
#
# Geheimnisse (Schlüssel, Client-Secret) stehen NICHT hier, sondern in deploy/secrets/.
# Sicherheitsrelevante Zahlen haben feste Grenzen. Liegt ein Wert außerhalb, startet das
# Portal nicht und nennt im Log (docker compose logs app) den Grund.
# Leere Werte bedeuten: Standard verwenden.

# ================================================================ Allgemein
COMPOSE_PROJECT_NAME=service-portal
# Welche optionalen Dienste laufen: clamav (Virenscan), updater (Updates aus der Oberfläche)
COMPOSE_PROFILES=clamav,updater
# Verzeichnis, in dem das Repository auf der VM liegt (absoluter Pfad!)
PORTAL_DIR=/opt/zammad-service-portal
# Installierte Version (wird vom Updater gepflegt)
APP_VERSION=1.2.0

# Hostname, unter dem das Portal intern erreichbar ist (muss zum Zertifikat passen).
# Zum Testen ohne DNS-Eintrag geht auch die IP der VM, z. B. PORTAL_HOST=192.168.1.50
PORTAL_HOST=serviceportal.firma.intern
# Adresse, die im Browser eingegeben wird. Bei einem anderen Port als 443 gehört er dazu,
# z. B. https://serviceportal.firma.intern:8443
PUBLIC_URL=https://serviceportal.firma.intern
# Ports auf der VM: HTTPS (Portal) und HTTP (leitet nur auf HTTPS weiter).
# Ändern, wenn 443/80 schon von etwas anderem belegt sind.
HTTPS_PORT=443
HTTP_PORT=80
# Nur auf dieser IP der VM lauschen (0.0.0.0 = alle)
BIND_ADDRESS=0.0.0.0

# ================================================================ Microsoft Entra ID
# Tenant, in dem die App registriert ist
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Alle Tenants, deren Benutzer sich anmelden dürfen (Komma-getrennt), z. B. beide Tenants eines Firmenverbunds
ENTRA_ALLOWED_TENANTS=

# ================================================================ Lokale Konten
# Lokale Anmeldung (Benutzername + Passwort) erlauben. Für Erstinstallation und Notfall.
# Nach der Einrichtung von Entra ID auf false setzen. Bei false enden auch offene lokale Sitzungen sofort.
LOCAL_LOGIN_ENABLED=true
# Zwei-Faktor-Anmeldung (Authenticator-App) für lokale Konten mit Verwaltungsrechten. Standard: true.
# Wird bei jeder Anfrage geprüft – bekommt jemand Admin-Rechte, muss er sofort 2FA einrichten.
LOCAL_ADMIN_REQUIRE_TOTP=true
# Zwei-Faktor-Anmeldung auch für normale lokale Benutzer verlangen. Standard: false (freiwillig).
LOCAL_USER_REQUIRE_TOTP=false
# Mindestlänge für eigene Passwörter (10 bis 128, Standard 12)
PASSWORD_MIN_LENGTH=12

# ================================================================ Kontosperre
# Falsche Passwörter, falsche 2FA-Codes und falsche Bestätigungen zählen gemeinsam.
# Fehlversuche bis zur Sperre (3 bis 20, Standard 5)
LOGIN_MAX_ATTEMPTS=5
# Dauer der ersten Sperre in Minuten (1 bis 1440, Standard 15)
LOGIN_LOCK_MINUTES=15
# Jede weitere Sperre doppelt so lang (15, 30, 60 … Minuten). Standard: true
LOGIN_LOCK_PROGRESSIVE=true
# Längste Sperre in Minuten (mindestens LOGIN_LOCK_MINUTES, höchstens 10080 = 7 Tage, Standard 1440 = 24 h)
LOGIN_LOCK_MAX_MINUTES=1440

# ================================================================ Sitzungen
# Abmeldung nach Inaktivität in Minuten (5 bis 480, Standard 30)
SESSION_IDLE_MINUTES=30
# Spätestens nach so vielen Stunden neu anmelden (1 bis 24, Standard 10)
SESSION_MAX_HOURS=10
# Kritische Aktionen (Rollen, Benutzer, Zugangsdaten, Updates) nur mit einer Anmeldung,
# die höchstens so viele Minuten alt ist – sonst Bestätigung mit Passwort/Microsoft (1 bis 60, Standard 10)
STEPUP_MINUTES=10

# ================================================================ Zugriff
# Admin-Bereich nur aus diesen Netzen (Komma-getrennt, z. B. 10.10.0.0/16). Leer = überall,
# wo das Portal erreichbar ist.
ADMIN_ALLOWED_CIDRS=
# Ratenbegrenzung je IP-Adresse
# Anmeldeversuche: so viele sofort (3 bis …, Standard 10), danach so viele pro Minute (Standard 10)
RATE_LIMIT_LOGIN_BURST=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Alle API-Aufrufe (Standard 240) und ändernde Aufrufe (Standard 60) als Burst
RATE_LIMIT_API_BURST=240
RATE_LIMIT_WRITE_BURST=60

# ================================================================ Uploads und Daten
# Uploads ablehnen, wenn ClamAV nicht erreichbar ist
CLAMAV_REQUIRED=true
# Wie lange Anfrage-Inhalte nach der Zustellung im Portal bleiben (Tage, 1 bis 3650)
RETENTION_DAYS=30
# Zammad nur per http erreichbar? Dann true (besser: https)
ALLOW_HTTP_TICKET_URLS=

# ================================================================ Updates
# git = neue Versionen als Git-Tags holen und auf der VM bauen (kein GitHub-Actions-Guthaben nötig)
# registry = signierte Images aus einer Registry ziehen (GHCR)
UPDATE_SOURCE=git
# Nur Tags installieren, die mit einem Schlüssel aus deploy/allowed_signers signiert sind
UPDATE_REQUIRE_SIGNED_TAGS=true
REGISTRY_IMAGE=ghcr.io/hundexe/zammad-service-portal

# ================================================================ Netz (nur bei Konflikten ändern)
PROXY_NET_CIDR=172.30.10.0/24
PROXY_IP=172.30.10.2
PROXY_NET_DYNAMIC=172.30.10.128/25
LOG_LEVEL=info
