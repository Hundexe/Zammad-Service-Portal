# Caddy – Reverse Proxy vor dem Self-Service-Portal
{
	admin off
	# Ports aus deploy/.env (HTTPS_PORT, HTTP_PORT). HTTP leitet nur auf HTTPS weiter.
	https_port {$HTTPS_PORT:443}
	http_port {$HTTP_PORT:80}
	# Clients ohne SNI (Aufruf über die IP, durch Docker-NAT) bekommen trotzdem das richtige Zertifikat
	default_sni {$PORTAL_HOST}
	# Stammzertifikat nicht in den Container-Zertifikatsspeicher eintragen (dort nutzlos)
	skip_install_trust
	# Interne Installation: Zertifikate kommen aus tls.caddy (interne CA oder Firmenzertifikat),
	# es werden keine öffentlichen Zertifikate bei Let's Encrypt angefragt.
	servers {
		protocols h1 h2
	}
}

# HTTP leitet nur weiter – mit Port, falls nicht der Standard
http://{$PORTAL_HOST}:{$HTTP_PORT:80} {
	redir https://{$PORTAL_HOST}:{$HTTPS_PORT:443}{uri} 308
}

{$PORTAL_HOST}:{$HTTPS_PORT:443} {
	import /etc/caddy/tls.caddy
	import /etc/caddy/security-headers.caddy

	# Interne Dateien und versteckte Pfade gar nicht erst durchreichen
	@hidden path /.* */.*
	respond @hidden 404

	reverse_proxy app:3000 {
		header_up -X-Forwarded-Host
		transport http {
			read_timeout 120s
		}
	}
	log {
		output stdout
		format json
	}
}

# Andere Hostnamen oder die nackte IP bekommen kein Zertifikat – der TLS-Handshake schlägt fehl.
# Zusätzlich beantwortet die App nur Anfragen mit dem richtigen Host-Header (sonst 421).
