# TLS für das Portal – eingestellt über deploy/.env, diese Datei bleibt unverändert
# (Updates überschreiben sie; eigene Änderungen hier gingen dabei verloren).
#
# Standard: Zertifikat von der internen CA von Caddy. Das Stammzertifikat liegt danach im
# Volume caddy-data unter /data/caddy/pki/authorities/local/root.crt und muss per GPO an die Clients.
#
# Eigenes Zertifikat (z. B. von der internen Firmen-CA, empfohlen): Dateien nach deploy/certs/ legen
# und in deploy/.env eintragen (Pfade im Container):
#   TLS_CERT_FILE=/certs/portal.crt
#   TLS_KEY_FILE=/certs/portal.key
tls {$TLS_CERT_FILE:internal} {$TLS_KEY_FILE:}
