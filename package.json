{
  "name": "zammad-service-portal",
  "version": "1.13.0",
  "private": true,
  "license": "MIT",
  "description": "Self-Service-Portal für Zammad: Anfragen über Formulare, Tickets per Zammad-API, Anmeldung über Microsoft Entra ID.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "worker": "node --disable-warning=ExperimentalWarning src/server/worker.ts",
    "cli": "node --disable-warning=ExperimentalWarning src/server/cli.ts",
    "build": "node tools/build-web.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:security": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/security-*.test.ts'",
    "mock-zammad": "node tools/mock-zammad.ts",
    "demo": "node --disable-warning=ExperimentalWarning tools/build-web.ts && node --disable-warning=ExperimentalWarning tools/demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "undici-types": "^6.21.0",
    "typescript": "^6.0.2"
  }
}
